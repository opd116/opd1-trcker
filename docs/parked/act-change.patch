+
+/// For a backfill run that crosses an act change: act A from `a_start`, act B
+/// from `switch_ms` (valorant-api's dates alone, no Riot). The wall clock is
+/// put one hour before the switch, so act A is current;
+/// [`cross_into_act_b`] then moves it two hours on.
+pub(crate) fn acts_a_then_b(h: &Harness, a_start: i64, switch_ms: i64) {
+    h.st.set_acts_for_test(vec![
+        api_act(ACT_A, "ACT IV", a_start, switch_ms),
+        api_act(ACT_B, "ACT V", switch_ms, switch_ms + 60 * D),
+    ]);
+    h.st.advance_wall_clock(switch_ms - H - h.st.clock_ms());
+    assert_eq!(current_id(&h.st).as_deref(), Some(ACT_A));
+    assert_eq!(h.st.current_act().unwrap().start_ms, a_start);
+}
+
+/// The clock crosses the switch of [`acts_a_then_b`]: act B is current.
+pub(crate) fn cross_into_act_b(h: &Harness) {
+    h.st.advance_wall_clock(2 * H);
+    assert_eq!(current_id(&h.st).as_deref(), Some(ACT_B));
+}
