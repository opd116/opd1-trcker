+#[tokio::test]
+async fn note_act_change_reacts_once_however_often_or_concurrently_it_is_called() {
+    let h = harness().await;
+    let n = now_ms();
+    let t0 = crate::state::card_clock(n) + 2 * H;
+    date_rule_world(&h, n, t0).await;
+    let before = tally(&h);
+    // Nothing changed yet: calling it is free of effects.
+    for _ in 0..3 {
+        h.st.note_act_change().await;
+    }
+    idle(&h.st).await;
+    assert_eq!(tally(&h), before);
+
+    h.st.advance_wall_clock(t0 - n + H / 2);
+    // Eight callers at once (the tick, a Riot answer, a tables load): one of
+    // them reacts.
+    let callers: Vec<_> = (0..8)
+        .map(|_| {
+            let st = h.st.clone();
+            tokio::spawn(async move { st.note_act_change().await })
+        })
+        .collect();
+    for caller in callers {
+        caller.await.unwrap();
+    }
+    idle(&h.st).await;
+    let once = tally(&h);
+    assert_eq!(once.reactions, before.reactions + 1);
+    assert_eq!(once.live, before.live + 1);
+    assert_eq!(once.my_stats, before.my_stats + 1);
+    assert_eq!(
+        once.computed,
+        before.computed + 1,
+        "one recompute asked for"
+    );
+
+    // And again, one after the other.
+    for _ in 0..5 {
+        h.st.note_act_change().await;
+    }
+    idle(&h.st).await;
+    assert_eq!(tally(&h), once);
+}
