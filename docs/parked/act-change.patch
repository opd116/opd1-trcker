+async fn me_and_other_on_screen(h: &Harness) {
+    let slots = vec![
+        slot_for(&h.st, ME, false).await,
+        slot_for(&h.st, OTHER, false).await,
+    ];
+    {
+        let mut live = lock(&h.st.live);
+        live.stage = Stage::Ingame;
+        live.slots = slots;
+    }
+    h.st.publish();
+}
+
+/// Everything B6's tests count: how often the reaction ran, what the sink was
+/// given and how many My Stats recomputes were asked for.
+#[derive(Debug, PartialEq)]
+struct Tally {
+    reactions: usize,
+    live: usize,
+    my_stats: usize,
+    details: usize,
+    computed: usize,
+}
+
+fn tally(h: &Harness) -> Tally {
+    Tally {
+        reactions: h.st.act_reactions(),
+        live: h.live_events().len(),
+        my_stats: h.rec.my_stats.lock().unwrap().len(),
+        details: h.rec.details.lock().unwrap().len(),
+        computed: lock(&h.st.my_stats_push).computed,
+    }
+}
+
+/// `puuid`'s card in the last `"live"` event, as the UI gets it.
+fn live_card(h: &Harness, puuid: &str) -> Value {
+    let state = h.live_events().last().cloned().expect("a live event");
+    let card = state
+        .players
+        .iter()
+        .find(|c| c.puuid == puuid)
+        .expect("card on screen");
+    serde_json::to_value(card).unwrap()
+}
+
+fn last_my_stats(h: &Harness) -> opd1_core::model::MyStats {
+    h.rec
+        .my_stats
+        .lock()
+        .unwrap()
+        .last()
+        .cloned()
+        .expect("pushed")
+}
+
+fn last_details(h: &Harness) -> PlayerDetails {
+    h.rec
+        .details
+        .lock()
+        .unwrap()
+        .last()
+        .cloned()
+        .expect("emitted")
+}
+
+/// The first answer, once: Riot says act A runs for one more day.
+async fn mount_content_once(h: &Harness, body: Value) {
+    Mock::given(method("GET"))
+        .and(path("/content-service/v3/content"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(body))
+        .up_to_n_times(1)
+        .mount(&h.server)
+        .await;
+}
+
+/// Riot: act A (named `ACT 4`, Riot's own spelling) is active until `end`.
+fn content_a_until(n: i64, end: i64) -> Value {
+    json!({"Seasons": [
+        season(OLD_ACT, "ACT 3", n - 120 * D, n - 60 * D, false),
+        season(ACT_A, "ACT 4", n - 60 * D, end, true),
+    ]})
+}
+
+/// Riot: act A ended at `switch`, act B began there. With `names_a`, act A's
+/// entry is there to be found as the previous act; without it (Riot's list
+/// has no entry ending where B starts) nothing says what came before B.
+fn content_b_from(n: i64, switch: i64, names_a: bool) -> Value {
+    let mut seasons = vec![season(OLD_ACT, "ACT 3", n - 120 * D, n - 60 * D, false)];
+    if names_a {
+        seasons.push(season(ACT_A, "ACT 4", n - 60 * D, switch, false));
+    }
+    seasons.push(season(ACT_B, "ACT 5", switch, n + 90 * D, true));
+    json!({ "Seasons": seasons })
+}
+
+/// valorant-api's table. `late`: it lists act A running another 30 days (it
+/// has not caught up with the rollover); else its dates agree with Riot's, act
+/// A ending at `n + D`.
+fn valorant_api_acts(h: &Harness, n: i64, late: bool) {
+    let switch = if late { n + 30 * D } else { n + D };
+    h.st.set_acts_for_test(vec![
+        api_act(OLD_ACT, "ACT III", n - 120 * D, n - 60 * D),
+        api_act(ACT_A, "ACT IV", n - 60 * D, switch),
+        api_act(ACT_B, "ACT V", switch, n + 90 * D),
+    ]);
+}
+
+/// Act A's numbers on ME's and OTHER's cards, My Stats and OTHER's Details.
+fn assert_act_a_everywhere(h: &Harness) {
+    for who in [ME, OTHER] {
+        let card = live_card(h, who);
+        assert_eq!(card["actWins"], json!(8), "{who}");
+        assert_eq!(card["actGames"], json!(14), "{who}");
+        assert_eq!(card["rank"]["tier"], json!(15), "{who}");
+        assert_eq!(card["prevActTier"], json!(12), "{who}: the act before A");
+        assert_eq!(card["peak"]["tier"], json!(15), "{who}");
+        assert_eq!(card["peak"]["actLabel"], json!("V26 A4"), "{who}");
+        assert_eq!(
+            card["peak"]["sinceActEndMs"],
+            Value::Null,
+            "{who}: reached this act"
+        );
+    }
+    let stats = last_my_stats(h);
+    assert_eq!((stats.last5.len(), stats.rr_series.len()), (2, 2));
+    assert_eq!(stats.rank.tier, Some(15));
+    assert_eq!((stats.rank.wins, stats.rank.losses), (Some(1), Some(1)));
+}
+
+/// What an act that has just begun looks like everywhere: nothing of act A's.
+fn assert_new_act_everywhere(h: &Harness) {
+    for who in [ME, OTHER] {
+        let card = live_card(h, who);
+        assert_eq!(card["actWins"], Value::Null, "{who}: no act B entry in MMR");
+        assert_eq!(card["actGames"], Value::Null, "{who}");
+        assert_eq!(card["actWinrate"], Value::Null, "{who}");
+        assert_eq!(card["rank"], Value::Null, "{who}");
+        assert_eq!(
+            card["prevActTier"],
+            json!(15),
+            "{who}: A is the previous act"
+        );
+        // The peak is still act A's, now with its age instead of `This Act`.
+        assert_eq!(card["peak"]["tier"], json!(15), "{who}");
+        assert_eq!(card["peak"]["actLabel"], json!("V26 A4"), "{who}");
+        assert!(
+            card["peak"]["sinceActEndMs"]
+                .as_i64()
+                .is_some_and(|ms| ms >= 0),
+            "{who}: act A has ended: {}",
+            card["peak"]
+        );
+    }
+    let stats = last_my_stats(h);
+    assert!(stats.last5.is_empty(), "no match yet in the new act");
+    assert!(stats.rr_series.is_empty());
+    assert!(stats.session.is_none());
+    assert_eq!((stats.rank.tier, stats.rank.rr), (None, None));
+    assert_eq!((stats.rank.wins, stats.rank.losses), (None, None));
+    assert_eq!(stats.rank.net_rr, None);
+    assert!(stats.maps.is_empty() && stats.agents.is_empty());
+}
+
+/// The content-service switches acts mid-session: Riot answers act A (ending
+/// tomorrow), then, a day and two hours later, act B. `late`: valorant-api
+/// still dates act A as running on; else its dates already say B when Riot's
+/// answer arrives, so the date rule has changed the act before Riot says
+/// anything and the answer itself changes nothing.
+async fn riot_switches_acts_mid_session(late: bool) {
+    let h = harness().await;
+    let n = now_ms();
+    valorant_api_acts(&h, n, late);
+    for who in [ME, OTHER] {
+        store_mmr(&h.st, who).await;
+    }
+    store_act_a_match(&h.st, "b6-m1", n - 5 * H, true, 20).await;
+    store_act_a_match(&h.st, "b6-m2", n - 3 * H, false, -12).await;
+    me_and_other_on_screen(&h).await;
+    h.st.set_session(Some(h.session.clone()));
+
+    mount_content_once(&h, content_a_until(n, n + D)).await;
+    mount_content(&h, 200, content_b_from(n, n + D, true)).await;
+    h.st.refresh_content().await;
+    // The screen as the user has it: My Stats pushed, whatever else asked.
+    my_stats::notify(&h.st);
+    idle(&h.st).await;
+    assert_eq!(current_id(&h.st).as_deref(), Some(ACT_A));
+    assert_eq!(h.st.act_source(), "riot");
+    assert_act_a_everywhere(&h);
+
+    // The player has OTHER's page open: act A's hero stats and teammates.
+    let ticket = h.st.begin_open_details(OTHER);
+    let open = crate::details::build(&h.st, OTHER).await.unwrap();
+    assert!(h.st.set_open_details(ticket, &open));
+    assert_eq!(open.hero_matches, 2);
+    assert_eq!(
+        open.top_teammates.len(),
+        1,
+        "ME, from the two shared matches"
+    );
+    assert_eq!(
+        serde_json::to_value(&open.card).unwrap()["actGames"],
+        json!(14)
+    );
+
+    // A day and two hours pass; Riot's answer is stale now.
+    h.st.advance_wall_clock(D + 2 * H);
+    let before = tally(&h);
+    if late {
+        // valorant-api still says A: the act did not change, nothing reacts.
+        h.st.note_act_change().await;
+        assert_eq!(current_id(&h.st).as_deref(), Some(ACT_A));
+        assert_eq!(h.st.act_source(), "valorant-api");
+        assert_eq!(tally(&h), before);
+    } else {
+        // valorant-api's dates changed the act by themselves, and nothing has
+        // noticed yet: the screen is still act A's.
+        assert_eq!(current_id(&h.st).as_deref(), Some(ACT_B));
+        assert_eq!(h.st.act_source(), "valorant-api");
+        assert_act_a_everywhere(&h);
+    }
+
+    h.st.refresh_content().await;
+    idle(&h.st).await;
+
+    assert_eq!(current_id(&h.st).as_deref(), Some(ACT_B));
+    assert_eq!(h.st.act_source(), "riot");
+    let after = tally(&h);
+    assert_eq!(
+        after,
+        Tally {
+            reactions: before.reactions + 1,
+            live: before.live + 1,
+            my_stats: before.my_stats + 1,
+            details: before.details + 1,
+            computed: before.computed + 1,
+        },
+        "one republish, one My Stats push, one Details rebuild"
+    );
+    assert_new_act_everywhere(&h);
+    let rebuilt = last_details(&h);
+    assert_eq!(rebuilt.card.puuid, OTHER);
+    assert_eq!(rebuilt.hero_matches, 0, "hero stats are the new act's");
+    assert!(rebuilt.top_teammates.is_empty(), "so are the teammates");
+    assert_eq!(rebuilt.hero_kd, None);
+    let card = serde_json::to_value(&rebuilt.card).unwrap();
+    assert_eq!(card["actGames"], Value::Null);
+    assert!(card["peak"]["sinceActEndMs"].as_i64().is_some());
+    assert_eq!(
+        count(&h.server, "GET", "/content-service/v3/content").await,
+        2
+    );
+
+    // Riot says the same again: the act is not new, nothing reacts.
+    h.st.refresh_content().await;
+    idle(&h.st).await;
+    assert_eq!(tally(&h), after);
+}
+
