+/// `puuid`'s stored MMR: act O at tier 12 (10 wins), act A at tier 15, 42 RR,
+/// 8 wins in 14 games; nothing for act B.
+async fn store_mmr(st: &AppState, puuid: &str) {
+    let resp: PlayerMmrResponse = serde_json::from_value(json!({
+        "Subject": puuid,
+        "QueueSkills": {"competitive": {"SeasonalInfoBySeasonID": {
+            OLD_ACT: {"SeasonID": OLD_ACT, "CompetitiveTier": 12, "RankedRating": 10,
+                      "NumberOfWins": 10, "NumberOfGames": 20, "WinsByTier": {"12": 10}},
+            ACT_A: {"SeasonID": ACT_A, "CompetitiveTier": 15, "RankedRating": 42,
+                    "NumberOfWins": 8, "NumberOfGames": 14, "WinsByTier": {"15": 8}}
+        }}}
+    }))
+    .unwrap();
+    let snapshot = MmrSnapshot {
+        puuid: puuid.into(),
+        json: trim_mmr(&resp).to_string(),
+        last_comp_match_id: Some("m-old".into()),
+        fetched_ms: 1,
+    };
+    st.db(move |repo| repo.save_mmr_snapshot(&snapshot))
+        .await
+        .unwrap();
+}
