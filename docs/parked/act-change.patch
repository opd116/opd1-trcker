+/// valorant-api's dates alone: act A ends at `t0`, act B follows. The clock
+/// stands before `t0`; the first look at the act (the baseline) is taken.
+async fn date_rule_world(h: &Harness, n: i64, t0: i64) {
+    h.st.set_acts_for_test(vec![
+        api_act(OLD_ACT, "ACT III", t0 - 120 * D, t0 - 60 * D),
+        api_act(ACT_A, "ACT IV", t0 - 60 * D, t0),
+        api_act(ACT_B, "ACT V", t0, t0 + 60 * D),
+    ]);
+    for who in [ME, OTHER] {
+        store_mmr(&h.st, who).await;
+    }
+    store_act_a_match(&h.st, "b6-m1", n - 5 * H, true, 20).await;
+    store_act_a_match(&h.st, "b6-m2", n - 3 * H, false, -12).await;
+    me_and_other_on_screen(h).await;
+    // The first look (the tables' load) is the baseline.
+    h.st.note_act_change().await;
+    idle(&h.st).await;
+    assert_eq!(h.st.act_source(), "valorant-api");
+    assert_act_a_everywhere(h);
+}
