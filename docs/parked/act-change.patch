+    assert_eq!(h.st.act_reactions(), before.reactions + 1);
+    // My Stats was recomputed once (its bytes are the same for an empty
+    // account in either act, so nothing was emitted).
+    assert_eq!(tally(&h).computed, before.computed + 1);
+
+    // A re-check that changes nothing: no second reaction.
+    h.st.ensure_tables(true).await.expect("still loaded");
+    h.st.note_act_change().await;
+    idle(&h.st).await;
+    assert_eq!(h.st.act_reactions(), before.reactions + 1);
