+        n + 60 * D,
+    )]);
+    me_and_other_on_screen(&h).await;
+    h.st.note_act_change().await;
+    idle(&h.st).await;
+    let before = tally(&h);
+    assert_eq!(current_id(&h.st).as_deref(), Some("act-stale-b6"));
+
+    mount_asset_tables(&h.assets_server).await;
+    h.st.ensure_tables(false).await.expect("tables load");
+    assert_eq!(current_id(&h.st).as_deref(), Some(ACT));
+    assert_eq!(
+        h.st.act_reactions(),
