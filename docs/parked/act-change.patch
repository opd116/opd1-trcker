+/// A competitive match of act A that ME and OTHER played on the same team,
+/// with ME's RR row for it.
+async fn store_act_a_match(st: &AppState, id: &str, start_ms: i64, win: bool, rr: i64) {
+    let m = Match {
+        match_id: id.into(),
+        map_id: "/Game/Maps/Ascent/Ascent".into(),
+        queue_id: "competitive".into(),
+        start_ms,
+        winning_team: Some(if win { "Blue" } else { "Red" }.into()),
+        is_ranked: true,
+        rounds_played: Some(20),
+        game_length_ms: None,
+    };
+    let team = |id: &str, won: bool| MatchTeam {
+        team_id: id.into(),
+        won,
+        rounds_won: Some(if won { 13 } else { 8 }),
+        rounds_won_h1: None,
+    };
+    let teams = vec![team("Blue", win), team("Red", !win)];
+    let mut mine = player_row(ME, "Blue", "Me", "TAG");
+    (mine.kills, mine.deaths, mine.rounds) = (20, 10, Some(20));
+    let mut other = player_row(OTHER, "Blue", "Other", "OTH");
+    (other.kills, other.deaths, other.rounds) = (15, 15, Some(20));
+    let row = CompUpdateRow {
+        match_id: id.into(),
+        season_id: ACT_A.into(),
+        tier_after: 15,
+        tier_before: Some(15),
+        rr_after: 42,
+        rr_earned: rr,
+        map_id: None,
+        start_ms,
+    };
+    st.db(move |repo| {
+        repo.upsert_match(&m, &teams, &[mine, other])?;
+        repo.upsert_comp_updates(ME, &[row])
+    })
+    .await
+    .unwrap();
+}
